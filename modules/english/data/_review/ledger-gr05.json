{"chapter": "gr05", "entries": [{"en": "She likes apples.", "final": {"at": "2026-10-14", "by": "红队", "note": "母语者替换测试通过；语域通用；美式拼写。", "verdict": "pass"}, "first": {"at": "2026-10-14", "by": "英语专家队", "note": "规则表述准确（三单现适用条件完整）；术语与 M3 一致；中文释义适合初中生；无中式英语。", "verdict": "pass"}, "id": "gr05.1.1-e1", "lesson": "gr05.1.1", "register": "neutral", "revision": 1, "rule": "三单现 -s（正例 example）", "status": "final_passed", "vocab": "in-scope", "written_at": "2026-10-14", "written_by": "语法生产队", "zh": "她喜欢苹果。"}, {"en": "He goes to school by bike.", "final": {"at": "2026-10-14", "by": "红队", "note": "自然；by bike 为常用搭配（ride a bike 亦可，已在页面点拨注明）。", "verdict": "pass"}, "first": {"at": "2026-10-14", "by": "英语专家队", "note": "go→goes 拼写规则正确；主语 he 为第三人称单数，条件成立。", "verdict": "pass"}, "id": "gr05.1.1-e2", "lesson": "gr05.1.1", "register": "neutral", "revision": 1, "rule": "三单现 -s（正例 example；-es 拼写）", "status": "final_passed", "vocab": "in-scope", "written_at": "2026-10-14", "written_by": "语法生产队", "zh": "他骑自行车去上学。"}, {"en": "My mother gets up at six every morning.", "final": {"at": "2026-10-14", "by": "红队", "note": "自然，校园/家庭场景，语域通用。", "verdict": "pass"}, "first": {"at": "2026-10-14", "by": "英语专家队", "note": "单数名词主语同样触发三单现，条件卡覆盖此情形，表述一致。", "verdict": "pass"}, "id": "gr05.1.1-e3", "lesson": "gr05.1.1", "register": "neutral", "revision": 1, "rule": "三单现 -s（正例 example；单数名词主语）", "status": "final_passed", "vocab": "in-scope", "written_at": "2026-10-14", "written_by": "语法生产队", "zh": "我妈妈每天早上六点起床。"}, {"en": "He does his homework after dinner.", "final": {"at": "2026-10-14", "by": "红队", "note": "自然，家庭日常场景。", "verdict": "pass"}, "first": {"at": "2026-10-14", "by": "英语专家队", "note": "do→does 特殊变化正确；do homework 搭配正确。", "verdict": "pass"}, "id": "gr05.1.1-e4", "lesson": "gr05.1.1", "register": "neutral", "revision": 1, "rule": "do→does（正例 example）", "status": "final_passed", "vocab": "in-scope", "written_at": "2026-10-14", "written_by": "语法生产队", "zh": "晚饭后他做作业。"}, {"en": "Does she like music?", "final": {"at": "2026-10-14", "by": "红队", "note": "自然的一般疑问句，语域通用。", "verdict": "pass"}, "first": {"at": "2026-10-14", "by": "英语专家队", "note": "助动词 does 后动词用原形 like，还原规则表述准确。", "verdict": "pass"}, "id": "gr05.1.1-e5", "lesson": "gr05.1.1", "register": "neutral", "revision": 1, "rule": "does + 动词还原（正例 example）", "status": "final_passed", "vocab": "in-scope", "written_at": "2026-10-14", "written_by": "语法生产队", "zh": "她喜欢音乐吗？"}, {"en": "She doesn't watch TV at night.", "final": {"at": "2026-10-14", "by": "红队", "note": "自然，家庭日常场景。", "verdict": "pass"}, "first": {"at": "2026-10-14", "by": "英语专家队", "note": "doesn't 缩写形式正确；watch TV 搭配正确。", "verdict": "pass"}, "id": "gr05.1.1-e6", "lesson": "gr05.1.1", "register": "neutral", "revision": 1, "rule": "doesn't + 动词还原（正例 example）", "status": "final_passed", "vocab": "in-scope", "written_at": "2026-10-14", "written_by": "语法生产队", "zh": "她晚上不看电视。"}, {"en": "He has a new bike.", "final": {"at": "2026-10-14", "by": "红队", "note": "自然，语域通用。", "verdict": "pass"}, "first": {"at": "2026-10-14", "by": "英语专家队", "note": "have→has 特殊变化正确；a new bike 冠词用法正确。", "verdict": "pass"}, "id": "gr05.1.1-e7", "lesson": "gr05.1.1", "register": "neutral", "revision": 1, "rule": "have→has（正例 example）", "status": "final_passed", "vocab": "in-scope", "written_at": "2026-10-14", "written_by": "语法生产队", "zh": "他有一辆新自行车。"}, {"en": "She has lunch at noon.", "final": {"at": "2026-10-14", "by": "红队", "note": "revision 1（She has lunch at twelve.）终审打回：at twelve 裸时间不自然，母语者多用 at noon / at twelve o'clock；revision 2 改为 at noon 后复审通过，自然，语域通用。", "verdict": "pass"}, "first": {"at": "2026-10-14", "by": "英语专家队", "note": "revision 1 初审通过（语法无误）；revision 2 复审：改写后规则/术语仍准确。", "verdict": "pass"}, "id": "gr05.1.1-e8", "lesson": "gr05.1.1", "register": "neutral", "revision": 2, "rule": "have→has（正例 example）", "status": "final_passed", "vocab": "in-scope", "written_at": "2026-10-14", "written_by": "语法生产队", "zh": "她中午吃午饭。"}, {"en": "Does he have a pen?", "final": {"at": "2026-10-14", "by": "红队", "note": "自然的一般疑问句，语域通用。", "verdict": "pass"}, "first": {"at": "2026-10-14", "by": "英语专家队", "note": "does 后 have 还原为原形（不用 has），规则表述准确，为本课第二纠偏点的正例支撑。", "verdict": "pass"}, "id": "gr05.1.1-e9", "lesson": "gr05.1.1", "register": "neutral", "revision": 1, "rule": "does + have 还原（正例 example；have 不用 has）", "status": "final_passed", "vocab": "in-scope", "written_at": "2026-10-14", "written_by": "语法生产队", "zh": "他有钢笔吗？"}, {"en": "He go to school.", "final": {"at": "2026-10-14", "by": "红队", "note": "作为反例条/中式纠偏条使用合规：须标 ✗、附地道纠正句与一句话为什么（≤40 字）。", "verdict": "pass"}, "first": {"at": "2026-10-14", "by": "英语专家队", "note": "反例设定正确：主语 he 为第三人称单数而动词漏 -s，确为本课第一纠偏点；页面渲染须配 ✗ 标记与纠正句。", "verdict": "pass"}, "id": "gr05.1.1-e10", "lesson": "gr05.1.1", "register": "neutral", "revision": 1, "rule": "三单现 -s（反例 counter；全书第一纠偏点）", "status": "final_passed", "vocab": "in-scope", "written_at": "2026-10-14", "written_by": "语法生产队", "zh": "（错句）他去上学。"}, {"en": "Does he likes music?", "final": {"at": "2026-10-14", "by": "红队", "note": "作为反例条使用合规：须标 ✗、附地道纠正句与一句话为什么。", "verdict": "pass"}, "first": {"at": "2026-10-14", "by": "英语专家队", "note": "反例设定正确：does 已承担三单标记，likes 误加 -s，确为本课第二纠偏点。", "verdict": "pass"}, "id": "gr05.1.1-e11", "lesson": "gr05.1.1", "register": "neutral", "revision": 1, "rule": "does + 动词还原（反例 counter；助动词后误加 -s）", "status": "final_passed", "vocab": "in-scope", "written_at": "2026-10-14", "written_by": "语法生产队", "zh": "（错句）"}, {"id": "gr05.1.1-e12", "lesson": "gr05.1.1", "en": "My sister has long hair.", "zh": "我姐姐有一头长发。", "register": "neutral", "rule": "have→has（正例 example；单数名词主语）", "vocab": "in-scope", "written_at": "2026-10-14", "written_by": "语法生产队", "first": {"by": "英语专家队", "at": "2026-10-14", "verdict": "pass", "note": "have→has 特殊变化正确；单数名词主语触发三单现，条件卡已覆盖。"}, "final": {"by": "红队", "at": "2026-10-14", "verdict": "pass", "note": "自然，家庭场景；have long hair 为常用搭配。"}, "status": "final_passed", "revision": 1}], "note": "英语语法例句三审台账（D3）。字段与状态定义见 docs/english-grammar-review-ledger.md。gr05.1.1 试点课例句 12 条（正例 10 / 反例 2），已全部走完「撰写 → 英语专家队初审 → 红队终审」；其中 gr05.1.1-e8 曾被红队打回 1 次（revision 1→2）。", "schema": "grammar-review-ledger/1.0"}